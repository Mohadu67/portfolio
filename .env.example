# Authentification Dashboard (générer avec: openssl rand -hex 32)
API_SECRET=your-secret-key-here

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Google Gemini API (utilisée par lib/gemini.ts + agent Telegram)
# gemini-2.5-flash n'est plus dispo pour les nouvelles clés → défauts ici
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.8-flash
CHAT_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-tts
FALLBACK_EXTRACTION_MODEL=gemini-3.8-flash

# MongoDB URI
MONGO_URI=mongodb://localhost:27017/stage_agent

# Gmail SMTP (utiliser un mot de passe d'application, pas le vrai mot de passe)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# RapidAPI (JSearch + Indeed)
RAPIDAPI_KEY=xxxxxxxxxxxxxxxxxxxxx

# France Travail OAuth2
FRANCE_TRAVAIL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
FRANCE_TRAVAIL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

# Adzuna (optionnel — clés gratuites sur developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# SerpAPI (recherche entreprises via Google)
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxx

# Telegram — validation humaine des auto-réponses (cf. docs/TELEGRAM-APPROVAL.md)
# Bot créé via @BotFather ; secret webhook : openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Profil personnel (utilisé dans la génération de lettres)
PROFIL_NOM=Mohammed Hamiani
PROFIL_FORMATION=Concepteur Développeur Fullstack
PROFIL_COMPETENCES=JavaScript, React, Node.js, Python, SQL, Git, Docker
PROFIL_EXPERIENCE=Projets fullstack, UI/UX design, développement web moderne
PROFIL_RECHERCHE=Stage 2026 + Alternance Sept 2026
PROFIL_DISPO=Dès que possible